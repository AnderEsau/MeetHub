<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/blanco">
    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/logo_meethub"
        android:contentDescription="@string/logo_descripcion" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/splash_titulo"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/azul_oscuro"
        android:layout_marginTop="8dp"
        android:gravity="center" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/splash_subtitulo"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/cafe"
        android:layout_marginTop="6dp"
        android:gravity="center" />
    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/cafe"
        android:layout_marginTop="48dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/splash_cargando"
        android:textSize="13sp"
        android:textColor="@color/texto"
        android:layout_marginTop="12dp"
        android:gravity="center" />
</LinearLayout>
