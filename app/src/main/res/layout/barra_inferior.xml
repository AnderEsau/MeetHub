<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/blanco">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borde" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/btnInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icInicio"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_inicio"
                android:contentDescription="@null"
                app:tint="@color/cafe"
                android:padding="5dp" />
            <TextView
                android:id="@+id/txtNavInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_inicio"
                android:textSize="12sp"
                android:textColor="@color/cafe"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnSalas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icSalas"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_salas"
                android:contentDescription="@null"
                app:tint="@color/cafe"
                android:padding="5dp" />
            <TextView
                android:id="@+id/txtNavSalas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_salas"
                android:textSize="12sp"
                android:textColor="@color/cafe"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnBuzon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icBuzon"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_buzon"
                android:contentDescription="@null"
                app:tint="@color/cafe"
                android:padding="5dp" />
            <TextView
                android:id="@+id/txtNavBuzon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_buzon"
                android:textSize="12sp"
                android:textColor="@color/cafe"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>