<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/encabezado_logo" />

    <TextView
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_regresar"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/cafe"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:minHeight="48dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cuenta_label_tipo"
                            android:textSize="14sp"
                            android:layout_marginTop="0dp"
                            android:textStyle="bold"
                            android:textColor="@color/texto" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <Spinner
                                android:id="@+id/spnTipo"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/fondo_campo" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/flecha_spinner"
                                android:textSize="18sp"
                                android:textColor="@color/texto"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginRight="14dp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cuenta_label_identificador"
                            android:textSize="14sp"
                            android:layout_marginTop="0dp"
                            android:textStyle="bold"
                            android:textColor="@color/texto" />

                        <EditText
                            android:id="@+id/txtIdentificador"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="@string/cuenta_hint_identificador"
                            android:inputType="text"
                            android:background="@drawable/fondo_campo"
                            android:padding="10dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuenta_label_nombre"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/texto" />

                <EditText
                    android:id="@+id/txtNombreCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/cuenta_hint_nombre"
                    android:inputType="textPersonName"
                    android:background="@drawable/fondo_campo"
                    android:padding="10dp"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginRight="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cuenta_label_correo"
                            android:textSize="14sp"
                            android:layout_marginTop="10dp"
                            android:textStyle="bold"
                            android:textColor="@color/texto" />

                        <EditText
                            android:id="@+id/txtCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="@string/cuenta_hint_correo"
                            android:inputType="textEmailAddress"
                            android:background="@drawable/fondo_campo"
                            android:padding="10dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cuenta_label_telefono"
                            android:textSize="14sp"
                            android:layout_marginTop="10dp"
                            android:textStyle="bold"
                            android:textColor="@color/texto" />

                        <EditText
                            android:id="@+id/txtTelefono"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="@string/cuenta_hint_telefono"
                            android:inputType="phone"
                            android:background="@drawable/fondo_campo"
                            android:padding="10dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuenta_label_psw"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/texto" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/txtPsw"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/cuenta_hint_psw"
                        android:inputType="textPassword"
                        android:background="@drawable/fondo_campo"
                        android:paddingLeft="10dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingRight="48dp" />

                    <ImageView
                        android:id="@+id/imgVerPsw"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_ojo"
                        android:contentDescription="@string/ojo_descripcion"
                        app:tint="@color/gris"
                        android:layout_gravity="end|center_vertical"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/password_ayuda"
                    android:textSize="12sp"
                    android:textColor="@color/texto"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuenta_label_pregunta"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/texto" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <Spinner
                        android:id="@+id/spnPregunta"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/fondo_campo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flecha_spinner"
                        android:textSize="18sp"
                        android:textColor="@color/texto"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginRight="14dp" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuenta_label_respuesta"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/texto" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/txtRespuesta"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/cuenta_hint_respuesta"
                        android:inputType="textPassword"
                        android:background="@drawable/fondo_campo"
                        android:paddingLeft="10dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingRight="48dp" />

                    <ImageView
                        android:id="@+id/imgVerRespuesta"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_ojo"
                        android:contentDescription="@string/ojo_descripcion"
                        app:tint="@color/gris"
                        android:layout_gravity="end|center_vertical"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <Button
                    android:id="@+id/btnCrearCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuenta_btn_crear"
                    android:backgroundTint="@color/cafe"
                    android:textColor="@color/blanco"
                    android:layout_marginTop="16dp"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>