<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/encabezado_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_regresar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/cafe"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/password_encabezado"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/cafe"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_tarjeta"
                android:padding="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/password_paso1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/cafe" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/password_label_identificador"
                    android:textSize="14sp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/texto" />

                <EditText
                    android:id="@+id/txtIdentificador"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/password_hint_identificador"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/fondo_campo"
                    android:padding="10dp"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnConsultar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/password_btn_consultar"
                    android:backgroundTint="@color/cafe_claro"
                    android:textColor="@color/blanco"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/layoutPregunta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/txtPregunta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fondo_aviso"
                        android:padding="10dp"
                        android:layout_marginTop="10dp"
                        android:textSize="13sp"
                        android:textColor="@color/texto" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_label_respuesta"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/texto" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/txtRespuesta"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="@string/password_hint_respuesta"
                            android:inputType="textPassword"
                            android:background="@drawable/fondo_campo"
                            android:paddingLeft="10dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingRight="48dp" />

                        <ImageView
                            android:id="@+id/imgVerRespuesta"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_ojo"
                            android:contentDescription="@string/ojo_descripcion"
                            app:tint="@color/gris"
                            android:layout_gravity="end|center_vertical"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/btnValidar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_btn_validar"
                        android:backgroundTint="@color/cafe_claro"
                        android:textColor="@color/blanco"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPaso2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/borde"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_paso2"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/cafe"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_label_nueva"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/texto" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/txtNueva"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="@string/password_hint_nueva"
                            android:inputType="textPassword"
                            android:background="@drawable/fondo_campo"
                            android:paddingLeft="10dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingRight="48dp" />

                        <ImageView
                            android:id="@+id/imgVerNueva"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_ojo"
                            android:contentDescription="@string/ojo_descripcion"
                            app:tint="@color/gris"
                            android:layout_gravity="end|center_vertical"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_ayuda"
                        android:textSize="12sp"
                        android:textColor="@color/texto"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_label_confirmar"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/texto" />

                    <EditText
                        android:id="@+id/txtConfirmar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/password_hint_confirmar"
                        android:inputType="textPassword"
                        android:background="@drawable/fondo_campo"
                        android:padding="10dp"
                        android:layout_marginTop="4dp" />

                    <Button
                        android:id="@+id/btnGuardar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/password_btn_guardar"
                        android:backgroundTint="@color/cafe"
                        android:textColor="@color/blanco"
                        android:layout_marginTop="16dp"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>